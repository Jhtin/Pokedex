<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/pokedex_bg">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="16dp">

        <!-- Pokeball-->
        <ImageView
            android:id="@+id/pokemonImage"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:src="@drawable/pokeball"
            android:layout_marginBottom="16dp"
            android:layout_marginTop="80dp"/>

        <!-- INFO CONTAINER-->
        <LinearLayout
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#80FFFFFF"
            android:padding="12dp"
            android:layout_marginBottom="16dp"
            android:layout_marginTop="60dp">

            <TextView
                android:id="@+id/txtId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ID: "
                android:textSize="15sp"
                android:textColor="#000000"
                android:padding="6dp"
                android:background="#40FFFFFF"/>

            <TextView
                android:id="@+id/txtName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Name: "
                android:textSize="16sp"
                android:textColor="#CC0000"
                android:textStyle="bold"
                android:padding="6dp"
                android:background="#40FFFFFF"/>

            <TextView
                android:id="@+id/txtType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Type: "
                android:textSize="15sp"
                android:textColor="#000000"
                android:padding="6dp"
                android:background="#40FFFFFF"/>

            <TextView
                android:id="@+id/txtHP"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="HP: "
                android:textSize="14sp"
                android:textColor="#333333"
                android:padding="4dp"/>

            <TextView
                android:id="@+id/txtAttack"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Attack: "
                android:textSize="14sp"
                android:textColor="#333333"
                android:padding="4dp"/>

            <TextView
                android:id="@+id/txtDefense"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Defense: "
                android:textSize="14sp"
                android:textColor="#333333"
                android:padding="4dp"/>

            <TextView
                android:id="@+id/txtSpAttack"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sp. Attack: "
                android:textSize="14sp"
                android:textColor="#333333"
                android:padding="4dp"/>

            <TextView
                android:id="@+id/txtSpDefense"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sp. Defense: "
                android:textSize="14sp"
                android:textColor="#333333"
                android:padding="4dp"/>

            <TextView
                android:id="@+id/txtSpeed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Speed: "
                android:textSize="14sp"
                android:textColor="#333333"
                android:padding="4dp"/>

        </LinearLayout>


        <EditText
            android:id="@+id/searchInput"
            android:layout_width="300dp"
            android:layout_height="48dp"
            android:hint="Enter Pokemon Name"
            android:padding="12dp"
            android:background="#80FFFFFF"
            android:textColor="#000000"
            android:layout_marginBottom="10dp"/>


        <LinearLayout
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btnSearch"
                android:layout_width="140dp"
                android:layout_height="48dp"
                android:text="SEARCH"
                android:textColor="#FFFFFF"
                android:backgroundTint="#80FF4444"/>

            <Button
                android:id="@+id/btnClear"
                android:layout_width="140dp"
                android:layout_height="48dp"
                android:text="CLEAR"
                android:textColor="#000000"
                android:backgroundTint="#80E0E0E0"/>
        </LinearLayout>

    </LinearLayout>

</RelativeLayout>